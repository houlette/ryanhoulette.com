<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} – {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.subtitle }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#14171b" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href="{{ page.url | toAbsolute }}">
  <meta property="og:type" content="{% if layout == "post.njk" %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.subtitle }}">
  <meta property="og:url" content="{{ page.url | toAbsolute }}">
  <meta property="og:image" content="{{ "/images/og.jpg" | toAbsolute }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="A rusted teal truck with a young tree growing in front of its headlight">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="masthead">
    <div class="brand">
      <a class="site-title" href="/">{{ site.title }}</a>
      <p class="tagline">{{ site.subtitle }}</p>
    </div>
    <nav aria-label="Site">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Posts</a>
      <a href="/bio/"{% if page.url == "/bio/" %} aria-current="page"{% endif %}>Bio</a>
      <a href="/feed.xml">Feed</a>
    </nav>
  </header>
  <figure class="hero">
    <picture>
      <source media="(max-width: 40rem)" type="image/webp" srcset="/images/hero-narrow-600.webp 600w, /images/hero-narrow-1100.webp 1100w" sizes="100vw" width="1100" height="733">
      <source media="(max-width: 40rem)" srcset="/images/hero-narrow-600.jpg 600w, /images/hero-narrow-1100.jpg 1100w" sizes="100vw" width="1100" height="733">
      <source type="image/webp" srcset="/images/hero-1000.webp 1000w, /images/hero-1488.webp 1488w" sizes="(max-width: 62.5rem) 100vw, 1000px">
      <img src="/images/hero-1000.jpg" srcset="/images/hero-1000.jpg 1000w, /images/hero-1488.jpg 1488w" sizes="(max-width: 62.5rem) 100vw, 1000px" width="1000" height="288" alt="" fetchpriority="high">
    </picture>
  </figure>
  <main id="content">
{{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>© {{ site.title }} · Boston, Massachusetts</p>
    <p><a href="/feed.xml">Subscribe to the feed</a></p>
  </footer>
</body>
</html>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} – {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.subtitle }}">
  <link rel="stylesheet" href="/style.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
</head>
<body>
  <header class="masthead">
    <a class="site-title" href="/">{{ site.title }}</a>
    <p class="tagline">{{ site.subtitle }}</p>
    <nav>
      <a href="/">Posts</a>
      <a href="/bio/">Bio</a>
      <a href="/feed.xml">Feed</a>
    </nav>
  </header>
  <img class="banner" src="/wp-content/uploads/2012/04/cropped-SWYC2.jpg" width="1000" height="288" alt="">
  <main>
{{ content | safe }}
  </main>
  <footer>
    <p>© Ryan Houlette</p>
  </footer>
</body>
</html>

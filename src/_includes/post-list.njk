{#- Expects `posts`, newest first. -#}
{%- for group in posts | byYear %}
<h2 class="year">{{ group.year }}</h2>
<ol class="post-list">
{%- for post in group.posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time>
  </li>
{%- endfor %}
</ol>
{%- endfor %}

---
layout: base.njk
---
<article>
  <header class="post-header">
    <p class="eyebrow"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
    <h1>{{ title }}</h1>
    {%- if categories %}
    <ul class="tags">
      {%- for slug in categories %}
      <li><a href="/category/{{ slug }}/">{{ categoryNames[slug] or slug }}</a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </header>
  <div class="prose">
  {{ content | safe }}
  </div>
</article>
{%- set prev = collections.post | getPreviousCollectionItem %}
{%- set next = collections.post | getNextCollectionItem %}
{%- if prev or next %}
<nav class="pager" aria-label="More posts">
  {% if prev %}<a class="prev" href="{{ prev.url }}"><span>Older</span>{{ prev.data.title }}</a>{% endif %}
  {% if next %}<a class="next" href="{{ next.url }}"><span>Newer</span>{{ next.data.title }}</a>{% endif %}
</nav>
{%- endif %}

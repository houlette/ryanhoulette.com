---
layout: base.njk
pagination:
  data: collections.categoryList
  size: 1
  alias: category
permalink: "/category/{{ category }}/"
eleventyComputed:
  title: "{{ categoryNames[category] or category }}"
---
<header class="post-header">
  <p class="eyebrow"><a href="/">All posts</a></p>
  <h1>{{ title }}</h1>
</header>
{%- set posts = collections.post | inCategory(category) | reverse %}
{% include "post-list.njk" %}

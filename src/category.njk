---
layout: base.njk
pagination:
  data: collections.categoryList
  size: 1
  alias: category
permalink: "/category/{{ category }}/"
eleventyComputed:
  title: "{{ categoryNames[category] or category }}"
---
<h1>{{ title }}</h1>
<ul class="post-list">
{%- for post in collections.post | inCategory(category) | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
  </li>
{%- endfor %}
</ul>
